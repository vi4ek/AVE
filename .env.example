OPENAI_API_KEY=sk-your_openai_api_key_here

# Optional: AWS Lambda Serverless Cloud Rendering credentials
REMOTION_AWS_ACCESS_KEY_ID=
REMOTION_AWS_SECRET_ACCESS_KEY=
REMOTION_AWS_REGION=us-east-1
